# Database
DATABASE_URL=postgres://mello:mello123@localhost:5432/mello?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h

# Server
SERVER_PORT=8080
SERVER_ENV=development

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mello-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mello.app

# App URL (for email verification links)
APP_URL=http://localhost:3000

# Admin (first admin email - will be set as admin on register)
INITIAL_ADMIN_EMAIL=admin@example.com
